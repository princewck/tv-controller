# 首次部署先运行域名配置脚本；PUBLIC_ORIGIN 必须含 https://。配置权限0640或更严格。
PUBLIC_ORIGIN=https://tv.example.com
PORT=3000
DATABASE_PATH=/var/lib/tv-parent-control/control.sqlite
# 上海自然日，固定UTC+8，无夏令时。
DAILY_LIMIT_SECONDS=1800
REWARD_SECONDS=1200
# 不含小爱/米家/系统桌面/浏览器。QQ音乐不计入视频时长，可由家长另行决定。
MONITORED_APPS=com.ktcp.video,com.xiaodianshi.tv.yst,com.newtv.cboxtv,com.google.android.youtube.tv,com.fongmi.android.tv,com.gitvdemo.video,com.hunantv.license

# 管理员口令仅存加盐哈希JSON，真实文件不提交Git。
ADMIN_PASSWORD_FILE=/etc/tv-parent-admin.json

# 可选：面向儿童内容的审核网关。未配置/超时/拒绝/摘要不匹配均禁止发布。
# 请阅读 docs/LEARNING-AND-DISPLAY.md，网关需审核真实内容、用途与年龄上下文。
# CONTENT_REVIEW_ENDPOINT=https://review.example.com/child-tv-check
# CONTENT_REVIEW_SECRET_FILE=/etc/tv-content-review.token
